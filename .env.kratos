# Loaded by `vite --mode kratos` (the web server of `bun run e2e:kratos`) on
# top of `.env`. The identity service is a real Ory Kratos started by
# playwright.kratos.config.ts on this machine; every other backend points at
# a closed local port and the specs answer what they need with page.route().
VITE_HARUKI_TOOLBOX_DIRECT_URL=http://127.0.0.1:9
VITE_HARUKI_TOOLBOX_CDN_URL=http://127.0.0.1:9
VITE_HARUKI_TOOLBOX_AUTH_URL=http://localhost:4433
VITE_HARUKI_EVENT_TRACKER_URL=http://127.0.0.1:9
VITE_SEKAI_STATION_API_URL=http://127.0.0.1:9
