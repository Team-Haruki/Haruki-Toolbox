# Loaded by `vite --mode e2e` (the Playwright web server) on top of `.env`.
# Every backend points at a closed local port so the suite never depends on
# production availability: requests fail with a connection error at once
# instead of hanging on a struggling origin. Sekai master/asset CDNs are not
# configured here and stay real.
VITE_HARUKI_TOOLBOX_DIRECT_URL=http://127.0.0.1:9
VITE_HARUKI_TOOLBOX_CDN_URL=http://127.0.0.1:9
VITE_HARUKI_TOOLBOX_AUTH_URL=http://127.0.0.1:9
VITE_HARUKI_EVENT_TRACKER_URL=http://127.0.0.1:9
# Build-info update checks run outside production builds only when asked;
# app-update.e2e.ts drives them with a mocked /build-info.json.
VITE_APP_UPDATE_CHECKS=true
