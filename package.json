{
  "name": "haruki-toolbox",
  "private": true,
  "version": "9.5.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "test": "bun test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,vue}\" \"scripts/**/*.mjs\" \"vite.config.ts\"",
    "check:imports": "bun scripts/check-imports.mjs",
    "build": "bun run check:imports && vue-tsc --noEmit && vite build",
    "build:edgeone": "bun run check:imports && vite build",
    "preview": "vue-tsc --noEmit && bunx --bun vite preview",
    "typecheck": "bun run check:imports && vue-tsc --noEmit",
    "quality": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^15.0.0",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-uri": "^4.2.1",
    "haruki-sekai-deck-recommend-cpp": "0.4.1",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.29.4",
    "postcss": "^8.5.28",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "@babel/core": "^7.29.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "opencc-js": "^1.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
